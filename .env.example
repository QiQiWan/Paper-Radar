# Example environment variables. This file is not auto-loaded and contains no secrets.
# Local users normally configure model keys through the application's settings UI.
# PAPER_RADAR_USER_HOME=/absolute/path/to/local/research/data
# PAPER_RADAR_API_KEY=approved-model-api-key
# OPENALEX_API_KEY=optional-openalex-key
# PAPER_RADAR_SPRINGER_API_KEY=optional-springer-key
# PAPER_RADAR_ELSEVIER_API_KEY=optional-elsevier-key
# PAPER_RADAR_ELSEVIER_INSTTOKEN=optional-institution-token

# Public Web/Worker. Export through the OS, service manager or secrets manager.
# PAPERRADAR_PUBLIC_ORIGIN=https://papers.example.org
# PAPERRADAR_PUBLIC_PORT=8899
# PAPERRADAR_PORTAL_DATA=/var/lib/paperradar/portal
# PYTHON=/path/to/venv/bin/python
# PAPERRADAR_TRUST_PROXY_IP=1
# PAPERRADAR_JOB_WORKERS=2
# PAPERRADAR_MAX_PENDING_JOBS=100
# PAPERRADAR_DAILY_SEARCH_LIMIT=10
# PAPERRADAR_PUBLIC_LLM_BASE=https://approved-provider.example.org/v1
# PAPERRADAR_PUBLIC_LLM_MODEL=approved-model
# PAPERRADAR_PUBLIC_LLM_KEY=server-side-only-secret
# PAPERRADAR_PUBLIC_ALLOW_OPENALEX_API_KEY=1
